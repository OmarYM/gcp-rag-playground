# Server
PORT=8080
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# PostgreSQL (pgvector)
DB_USER=user
DB_PASSWORD=change-me-local-password
DB_NAME=rag_playground
DB_HOST=localhost
DB_PORT=5432

# Authentication (Google OAuth 2.0 Web Client ID)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_REDIRECT_URI=http://localhost:3000
# Optional: set DEV_AUTH_BYPASS=true only in local non-production development
# DEV_AUTH_BYPASS=false

# AI Provider: "gemini" (API key, easiest for local) or "vertex" (GCP ADC)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
EMBEDDING_MODEL=gemini-embedding-001
CHAT_MODEL=gemini-3.8-flash

# Google Cloud (required when AI_PROVIDER=vertex, STORAGE_MODE=gcs, or INGESTION_MODE=pubsub)
PROJECT_ID=your-gcp-project-id
REGION=us-central1

# Storage: "local" (disk, for local dev) or "gcs" (Google Cloud Storage)
STORAGE_MODE=local
LOCAL_UPLOAD_DIR=./uploads
UPLOAD_BUCKET=your-gcs-upload-bucket

# Ingestion: "inline" (in-process async, for local dev) or "pubsub" (Cloud Pub/Sub)
INGESTION_MODE=inline
PROCESSING_TOPIC=your-pubsub-topic-name
# Optional: verify OIDC tokens on /pubsub-webhook in Cloud Run
# PUBSUB_PUSH_SERVICE_ACCOUNT=your-sa@your-gcp-project-id.iam.gserviceaccount.com
# PUBSUB_VERIFICATION_AUDIENCE=https://your-backend-url.run.app
