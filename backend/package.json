{
  "name": "gcp-rag-playground-backend",
  "version": "1.0.0",
  "description": "Backend API for GCP RAG Playground",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
