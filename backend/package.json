    "clean": "gts clean",
    "compile": "tsc",
    "fix": "gts fix"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^6.4.1",
    "@google-cloud/storage": "^7.18.0",
    "@google/genai": "^1.33.0",
    "@langchain/core": "^1.1.6",
    "@langchain/textsplitters": "^1.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "google-auth-library": "^10.5.0",
    "gts": "^6.0.2",
    "mammoth": "^1.6.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.1",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.1",
    "gts": "^6.0.2",
    "nodemon": "^3.0.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
